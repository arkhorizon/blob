---
import { SITE } from "../lib/site";
import { ClientRouter } from "astro:transitions";
import "../styles/legacy.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: Date;
}

const {
  title,
  description = SITE.description,
  image,
  article = false,
  publishedTime
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang={SITE.locale} data-theme="oriental">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#a84038" />
    <meta name="application-name" content={SITE.name} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="apple-touch-fullscreen" content="yes" />
    <title>{pageTitle}</title>
    <ClientRouter fallback="swap" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {article && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      onload="this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      />
    </noscript>
    <script is:inline>
      try {
        const theme = localStorage.getItem("sy-theme") || "oriental";
        document.documentElement.setAttribute("data-theme", theme);
      } catch {}
    </script>
  </head>
  <body class:list={[article ? "article-page" : "list-page"]} transition:animate="none">
    <slot />
  </body>
</html>
