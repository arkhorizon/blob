---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articleSlug, getPublishedArticles } from "../../lib/articles";
import { getLegacyIndex, renderArticle, searchDocument } from "../../lib/legacy-content";
import ReadingApp from "../../react/components/ReadingApp";

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({
    params: { slug: articleSlug(article) },
    props: { article }
  }));
}

const { article } = Astro.props;
const slug = articleSlug(article);
const index = await getLegacyIndex();
const essay = index.essays[slug];
const contentData = renderArticle(article);
const fullText = searchDocument(article.data.title, article.data.description, contentData);
const giscusDefaults = {
  repo: "arkhorizon/blob-comments",
  repoId: "R_kgDOUyVdig",
  category: "Announcements",
  categoryId: "DIC_kwDOUyVdis4DHVny"
};
const giscus = {
  enabled: Object.values(giscusDefaults).every(Boolean),
  repo: import.meta.env.PUBLIC_GISCUS_REPO || giscusDefaults.repo,
  repoId: import.meta.env.PUBLIC_GISCUS_REPO_ID || giscusDefaults.repoId,
  category: import.meta.env.PUBLIC_GISCUS_CATEGORY || giscusDefaults.category,
  categoryId: import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || giscusDefaults.categoryId
};
---

<BaseLayout
  title={essay.title}
  description={essay.summary}
  image={essay.cover || undefined}
  article
  publishedTime={article.data.date}
>
  <div class="listRoute articleRoute" transition:persist="essay-list" aria-hidden="true"></div>
  <ReadingApp
    client:load
    essay={essay}
    essays={index.essays}
    essayOrder={index.essayOrder}
    contentData={contentData}
    giscus={giscus}
  />
  <div class="pagefind-source" data-pagefind-body set:html={fullText} />
</BaseLayout>
